# Webshare Proxy Server backbone connection. Replace every placeholder before startup.
WEBSHARE_MODE=backbone
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80
WEBSHARE_USERNAME=replace-with-webshare-proxy-username
WEBSHARE_PASSWORD=replace-with-webshare-proxy-password
WEBSHARE_API_KEY=replace-with-webshare-api-key
DEFAULT_COUNTRY=US

# Optional when the API key has more than one plan.
# WEBSHARE_PLAN_ID=replace-with-webshare-plan-id
